# ---- How the app finds its database -----------------------------------------------------------
# Local development without a database: everything is kept in memory and lost on restart.
# DIBS_STORE=memory
# Anything else: a Postgres connection string. Docker Compose builds this one for you.
# For Supabase use Project settings > Database > Connection string (URI). Add ?sslmode=require is NOT needed; TLS is automatic for supabase.co.
DATABASE_URL=postgres://dibs:change-me@localhost:5432/dibs
# on | off. Only needed if the automatic guess is wrong (it turns TLS on for supabase.co/.com hosts only).
# DATABASE_SSL=off

# ---- Public address (links, QR codes, cookies) ------------------------------------------------
# Use the real address people open. Starting with https:// makes cookies Secure.
APP_URL=http://localhost:3000

# ---- Reading bill photos and payment screenshots ----------------------------------------------
# Set ONE of these. If several are set, Anthropic wins, then OpenAI, then Gemini (or force one with BILL_PARSER).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# claude | openai | gemini | stub   (stub = a built-in sample bill, for trying the app with no key and no cost)
# BILL_PARSER=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Abuse limits (per IP, per hour; they protect your API credits) ---------------------------
# SCAN_LIMIT_PER_HOUR=20
# SHOT_LIMIT_PER_HOUR=30

# ---- Docker Compose only ---------------------------------------------------------------------
DOMAIN=krit.website
POSTGRES_PASSWORD=change-me
